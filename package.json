{
  "name": "finanalyzer",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "Продвинутый анализатор личных финансов: категории, бюджеты, ИИ-советник, импорт операций из уведомлений банка. APK собирается GitHub Actions (см. build-apk.yml.txt).",
  "scripts": {
